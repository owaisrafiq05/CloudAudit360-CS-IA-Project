# Database (SQLite for local; Postgres for Docker)
DATABASE_URL=sqlite:///./cloudaudit360.db
# DATABASE_URL=postgresql+psycopg2://cloudaudit:cloudaudit@db:5432/cloudaudit360

# App
SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=development
DEMO_MODE=true

# AWS (optional when DEMO_MODE=true)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ROLE_ARN=

# Default admin (used by seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
